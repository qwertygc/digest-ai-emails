{
  "manifest_version": 2,
  "name": "Digest IA",
  "version": "1.0.3",
  "description": "Regroupe les messages d'un dossier Thunderbird par thématique via l'API Mistral et génère une revue HTML de veille.",
  "browser_specific_settings": {
    "gecko": {
      "id": "digest-ia@justin.poncet",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["messagesRead", "accountsRead", "folders", "storage", "tabs"],
  "host_permissions": ["https://api.mistral.ai/*"],
  "background": {
    "scripts": ["digest-lib.js", "background.js"]
  },
  "browser_action": {
    "default_title": "Revue IA des messages",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
